{
  "mcpServers": {
    "openstudio-mcp": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-v",
        "./tests/assets:/inputs",
        "-v",
        "./runs:/runs",
        "-v",
        "./.claude/skills:/skills:ro",
        "-e",
        "OPENSTUDIO_MCP_MODE=prod",
        "openstudio-mcp:dev",
        "openstudio-mcp"
      ]
    }
  }
}
