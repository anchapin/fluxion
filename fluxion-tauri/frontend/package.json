{
  "name": "fluxion-gui-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + React Three Fiber frontend for the Fluxion Tauri GUI (issue #3178)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "cd .. && node frontend/node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "cd .. && node frontend/node_modules/@tauri-apps/cli/tauri.js build"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@react-three/fiber": "^8.17.10",
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
