class Model:
    """Standard single-building model for detailed building energy analysis.

    Use this class when you need detailed simulation of a single building with
    full control over construction, HVAC, weather, and surrogate evaluation.
    """

    def __init__(self, num_zones: int = 1) -> None: ...
    def num_zones(self) -> int: ...
    def get_temperatures(self) -> list[float]: ...
    def set_temperatures(self, temps: list[float]) -> None: ...
    def building_type(self) -> str: ...
    def set_building_type(self, building_type: str) -> None: ...
    def simulate(self, years: int, use_surrogates: bool) -> float: ...
    def simulate_with_loads(self, years: int, use_surrogates: bool) -> float: ...
    def simulate_numpy(
        self,
        dry_bulb_temp: Any,
        dni: Any,
        dhi: Any,
        ghi: Any,
        wind_speed: Any,
        humidity: Any,
        horizontal_infrared: Any,
        use_surrogates: bool,
    ) -> NDArray[np.float64]: ...
    def load_surrogate(self, model_path: str) -> None: ...
    def get_parameter_bounds(self) -> ParameterBounds: ...
    def validate_parameters_py(self, params: list[float]) -> None: ...
    def set_ground_temp(self, temperature: float) -> None: ...
    def ground_temperature_at(self, timestep: int) -> float: ...
    def zones(self) -> list[Zone]: ...
    def surfaces(self) -> list[Surface]: ...
    def set_surfaces(self, surfaces: list[Surface]) -> None: ...
    def hvac_system(self) -> HVACSystem: ...
    def set_hvac_system(self, hvac: HVACSystem) -> None: ...
    def __repr__(self) -> str: ...


class BatchOracle:
    """High-throughput parallel oracle for quantum / genetic-algorithm optimization.

    This is the core API for bulk evaluation of building design parameter
    populations. ``evaluate_population`` is parallelised with rayon at the
    population level (see the Batch-Oracle pattern, AGENTS.md).
    """

    def __init__(self) -> None: ...
    def evaluate_population(
        self, population: list[list[float]], use_surrogates: bool
    ) -> list[float]: ...
    def evaluate_population_typed(
        self, population: list[BuildingParameters], use_surrogates: bool
    ) -> list[float]: ...
    def evaluate_population_numpy(
        self, population: Any, use_surrogates: bool
    ) -> NDArray[np.float64]: ...
    def load_surrogate(self, model_path: str) -> None: ...
    def get_parameter_bounds(self) -> ParameterBounds: ...
    def validate_parameters_py(self, params: list[float]) -> None: ...


class ParameterBounds:
    """Parameter bounds for building design variables.

    Provides programmatic access to the valid ranges for all design
    parameters used by :class:`BatchOracle` and :class:`Model`.
    """

    @staticmethod
    def get_bounds() -> ParameterBounds: ...


class BuildingParameters:
    """Type-safe building design parameters with validation.

    Fields: ``window_u_value`` (0.0–6.0 W/m²K), ``heating_setpoint``
    (15.0–25.0 °C), ``cooling_setpoint`` (22.0–32.0 °C). The heating setpoint
    must be strictly less than the cooling setpoint.
    """

    def __init__(
        self, window_u_value: float, heating_setpoint: float, cooling_setpoint: float
    ) -> None: ...
    def to_vec(self) -> list[float]: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...


