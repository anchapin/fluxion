class Orientation(enum.Enum):
    """Compass orientation of a surface (mirrors ``ashrae_cases::Orientation``)."""
    North = 0
    East = 90
    South = 180
    West = 270
    Up = -1
    Down = -2
    Horizontal = -3

    @property
    def prefix(self) -> str: ...
    @property
    def azimuth_deg(self) -> float: ...
    def __repr__(self) -> str: ...


class ShadingType(enum.Enum):
    """Shading device classification.

    Note: the Rust ``None`` variant is exposed as ``none_`` because ``None`` is
    a Python keyword (PyO3 appends ``_`` to keyword-colliding enum variants).
    """
    none_ = 0  # type: ignore[assignment]  # Rust variant `None`
    Overhang = 1
    Fins = 2
    OverhangAndFins = 3


class ShadingDevice:
    """Shading device attached to a surface (overhang, fins, or both)."""

    def __init__(self) -> None: ...
    @staticmethod
    def none() -> ShadingDevice: ...
    @staticmethod
    def overhang(depth: float, height: float) -> ShadingDevice: ...
    @staticmethod
    def fins(width: float) -> ShadingDevice: ...
    @staticmethod
    def overhang_and_fins(overhang_depth: float, fin_width: float, height: float) -> ShadingDevice: ...
    def __repr__(self) -> str: ...


class Material:
    """Single material layer in a construction assembly (Python-side ``ConstructionLayer``)."""

    def __init__(
        self, name: str, conductivity: float, density: float, specific_heat: float, thickness: float
    ) -> None: ...
    def r_value(self) -> float: ...
    def thermal_capacitance_per_area(self) -> float: ...
    def __repr__(self) -> str: ...


class Surface:
    """Building surface (opaque wall, window, roof, or floor).

    Surfaces are organised per zone in the underlying thermal model.
    """

    def __init__(self, area: float, u_value: float, orientation: Orientation, window_area: float = 0.0) -> None: ...
    def append_shading(self, device: ShadingDevice) -> None: ...
    def add_overhang(self, depth: float, height: float) -> None: ...
    def add_fins(self, width: float) -> None: ...
    def total_area(self) -> float: ...
    def __repr__(self) -> str: ...


class Zone:
    """Single thermal zone (runtime snapshot from the parent model)."""

    def __init__(
        self,
        index: int,
        temperature: float,
        area: float,
        heating_setpoint: float = 20.0,
        cooling_setpoint: float = 24.0,
        hvac_enabled: bool = True,
        surfaces: list[Surface] = [],
    ) -> None: ...
    def surface_count(self) -> int: ...
    def total_surface_area(self) -> float: ...
    def surfaces_with_orientation(self, orientation: Orientation) -> list[Surface]: ...
    def __repr__(self) -> str: ...


class HVACSystem:
    """HVAC system configuration snapshot (validation-layer HVAC type)."""

    def __init__(
        self,
        heating_capacity: float,
        cooling_capacity: float,
        cop_heating: float,
        cop_cooling: float,
        stages: int,
        min_outdoor_temp: float,
        max_outdoor_temp: float,
