class MultiZoneThermalModel:
    """Multi-zone thermal model for Python (ASHRAE 140 + 9R4C multi-node)."""

    def __init__(self, num_zones: int = 2) -> None: ...
    @staticmethod
    def from_case_spec(
        case_id: str,
        zone_solver: str | None = None,
        conduction_solver: str | None = None,
    ) -> MultiZoneThermalModel:
        """Build a model from an ASHRAE 140 case id.

        ``zone_solver``: ``"gauge"`` (default) | ``"5r1c"`` | ``"9r4c"``.
        The experimental ``"6r2c"`` / ``"8r3c"`` values raise ``ValueError``
        unless ``FLUXION_EXPERIMENTAL_ZONE_SOLVERS=1`` is set (and stay
        unavailable until the experimental cargo feature ships; issue #3291).
        ``conduction_solver``: ``"default"`` (default) | ``"ctf"`` | ``"fd"``.
        """
        ...
    def num_zones(self) -> int: ...
    def get_inner_num_zones(self) -> int: ...
    def get_zone_temperatures(self) -> list[float]: ...
    def set_zone_temperatures(self, temps: list[float]) -> None: ...
    def set_zone_setpoints(self, zone_idx: int, heating: float, cooling: float) -> None: ...
    def get_inter_zone_conductance(self, zone_i: int, zone_j: int) -> float: ...
    def set_inter_zone_conductance(self, zone_i: int, zone_j: int, conductance: float) -> None: ...
    def set_inter_zone_conductance_vector(self, conductances: list[float]) -> None: ...
    def get_inter_zone_conductance_vector(self) -> list[float]: ...
    def simulate_multi_zone(self, years: int, use_surrogates: bool) -> float: ...
    def get_zone_energies(self) -> list[float]: ...
    def get_zone_peak_loads(self) -> dict[str, list[float]]: ...
    def get_zone_peaks(self, zone_identifier: Any) -> dict[str, Any]: ...
    def export_zone_temperatures(self) -> dict[str, Any]: ...
    def get_hourly_temperatures(self) -> list[list[float]] | None: ...
    def get_hourly_temperatures_numpy(self) -> tuple[NDArray[np.float64], list[int]]: ...
    # Issue #1799 — sub-hourly 9R4C node temperature traces
    def get_nodal_temperatures(self) -> list[list[list[float]]] | None: ...
    def num_multinode_solvers(self) -> int: ...
    def nodal_temperature_node_names(self) -> list[str]: ...
    def get_nodal_temperatures_numpy(self) -> tuple[NDArray[np.float64], list[int]]: ...
    def validate_energy_balance(self) -> bool: ...
    def validate_energy_balance_detailed(self) -> tuple[bool, float, int]: ...
    def is_energy_unbalanced(self) -> bool: ...


