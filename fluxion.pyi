"""Type stubs for the ``fluxion`` Python package (PyO3 bindings).

Auto-curated from the ``#[pymodule] fn fluxion`` registration in
``src/lib.rs`` plus the ``multi_zone`` submodule in ``src/python/bindings.rs``.
Every ``#[pyclass]`` registered in the primary ``fluxion`` module is listed
here. The drift gate ``scripts/check_pyi_drift.py`` (and the self-contained
Rust integration test ``tests/pyi_stub_completeness.rs``) assert that this file
stays in sync with the Rust registrations — see Issue #2509.

Rust→Python type translation conventions used throughout:
  ``&str``/``String`` → ``str`` · ``f64``/``f32`` → ``float`` ·
  ``usize``/``u32``/``i32`` → ``int`` · ``bool`` → ``bool`` ·
  ``Vec<T>`` → ``list[T]`` · ``Option<T>`` → ``T | None`` ·
  ``PyResult<T>`` → ``T`` (errors raised as ``FluxionError`` subclasses) ·
  ``&Bound<PyDict>``/``Py<PyDict>`` → ``dict[str, Any]`` ·
  ``Bound<numpy::PyArrayND<f64>>`` → ``NDArray[np.float64]`` ·
  ``HashMap<String, V>`` → ``dict[str, V]``.
"""

from __future__ import annotations

import enum
from typing import Any

import numpy as np
from numpy.typing import NDArray

# A schema dictionary (OpenStudio/gbXML/IFC interchange representation).
SchemaDict = dict[str, Any]


# ---------------------------------------------------------------------------
# Exception hierarchy
# ---------------------------------------------------------------------------

class FluxionError(Exception):
    """Base class for all fluxion runtime errors."""


class ValidationError(FluxionError):
    """Raised when building parameters or model inputs fail validation."""


class SurrogateError(FluxionError):
    """Raised when the ONNX surrogate model fails to load or infer."""


class SimulationError(FluxionError):
    """Raised when the thermal simulation fails to converge or step."""


# ---------------------------------------------------------------------------
# Top-level free functions
# ---------------------------------------------------------------------------

def import_osm(path: str) -> SchemaDict:
    """Import an OpenStudio ``.osm`` file into a schema dict."""


def export_osm(schema: SchemaDict, path: str) -> None:
    """Export a schema dict to an OpenStudio ``.osm`` file."""


def export_gbxml(schema: SchemaDict, path: str) -> None:
    """Export a schema dict to a Green Building XML (gbXML) file."""


def create_multi_zone_model_from_config(config: SchemaDict) -> MultiZoneThermalModel:
    """Build a :class:`MultiZoneThermalModel` from a config dictionary."""


def create_multi_zone_model_from_schema_file(schema_path: str) -> MultiZoneThermalModel:
    """Build a :class:`MultiZoneThermalModel` from a schema file on disk."""


def create_multi_zone_model_from_schema_dict(schema: SchemaDict) -> MultiZoneThermalModel:
    """Build a :class:`MultiZoneThermalModel` from an in-memory schema dict."""


def create_zone_setpoints(config: SchemaDict) -> ZoneSetpoints:
    """Construct :class:`ZoneSetpoints` from a config dictionary."""


def compute_vav_terminal_performance(
    terminal: VavTerminalUnit,
    entering_dry_bulb_c: float,
    entering_humidity_ratio: float,
    air_density_kg_per_m3: float,
