/// Test window convection with extreme temperature difference
#[test]
fn test_window_convection_extreme_temp_diff() {
    let layers = vec![MaterialLayer::new("Glass", 0.005, 1.0, 2300.0, 840.0)];
    let mut solver = ImplicitFDSolver::new(layers, 20);
    let interior_bc = SurfaceBC::new_interior(8.0, -20.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, 40.0, 0.0);
    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite() && t > -100.0 && t < 100.0));
}

/// Test solar radiation gain through window
#[test]
fn test_window_solar_radiation_gain() {
    let layers = vec![MaterialLayer::new("Glass", 0.006, 1.0, 2300.0, 840.0)];
    let mut solver = ImplicitFDSolver::new(layers, 20);
    let interior_bc = SurfaceBC::new_interior(8.0, 20.0);
    let exterior_bc = SurfaceBC::new_exterior(35.0, 30.0, 300.0);
    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    let max_temp = temps.iter().fold(f64::NEG_INFINITY, |a, &b| a.max(b));
    assert!(max_temp > 20.0);
}

/// Test window radiation with low emissivity (Low-E)
#[test]
fn test_window_radiation_low_e() {
