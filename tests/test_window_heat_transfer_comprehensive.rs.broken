#![allow(dead_code)]


use fluxion::physics::fd_discretization::MaterialLayer;
use fluxion::physics::fd_solver::{ImplicitFDSolver, SurfaceBC};

/// Test window conduction with single glazing layer
#[test]
fn test_window_conduction_single_glazing() {
    let layers = vec![MaterialLayer::new("Glass", 0.003, 1.0, 2300.0, 840.0)];
    let mut solver = ImplicitFDSolver::new(layers, 20);
    let interior_bc = SurfaceBC::new_interior(8.0, 20.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, 5.0, 0.0);
    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite() && t > -50.0 && t < 100.0));
}

/// Test window conduction with double glazing
#[test]
fn test_window_conduction_double_glazing() {
    let layers = vec![
        MaterialLayer::new("Glass 1", 0.003, 1.0, 2300.0, 840.0),
        MaterialLayer::new("Air gap", 0.012, 0.024, 1.2, 1000.0),
        MaterialLayer::new("Glass 2", 0.006, 1.0, 2300.0, 840.0),
    ];
    let mut solver = ImplicitFDSolver::new(layers, 30);
    let interior_bc = SurfaceBC::new_interior(8.0, 20.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, 5.0, 0.0);
    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.len() >= 30);
}

/// Test window conduction with low-E coating
#[test]
fn test_window_conduction_low_e_coating() {
