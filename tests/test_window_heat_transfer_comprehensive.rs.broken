}

/// Test window during peak solar hours
#[test]
fn test_window_peak_solar() {
    let layers = vec![MaterialLayer::new("Glass", 0.006, 1.0, 2300.0, 840.0)];
    let mut solver = ImplicitFDSolver::new(layers, 20);
    let interior_bc = SurfaceBC::new_interior(8.0, 24.0);
    let exterior_bc = SurfaceBC::new_exterior(38.0, 35.0, 1000.0);
    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite() && t < 80.0));
}

/// Test window with thermal mass (concrete wall with window)
#[test]
fn test_window_with_thermal_mass() {
    let layers = vec![
        MaterialLayer::new("Glass", 0.006, 1.0, 2300.0, 840.0),
        MaterialLayer::new("Concrete", 0.200, 1.4, 2300.0, 880.0),
    ];
    let mut solver = ImplicitFDSolver::new(layers, 30);
    let interior_bc = SurfaceBC::new_interior(8.0, 20.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, 28.0, 400.0);
    solver.step(7200.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite()));
}

/// Test window with very thin glazing
#[test]
fn test_window_very_thin_glazing() {
    let layers = vec![MaterialLayer::new("Thin Glass", 0.001, 1.0, 2300.0, 840.0)];
    let mut solver = ImplicitFDSolver::new(layers, 15);
    let interior_bc = SurfaceBC::new_interior(8.0, 20.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, 25.0, 0.0);
    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite()));
    assert!(temps[0] - temps[temps.len() - 1] > 10.0);
}

/// Test window with very thick insulation
#[test]
fn test_window_very_thick_insulation() {
    let layers = vec![
        MaterialLayer::new("Glass", 0.005, 1.0, 2300.0, 840.0),
        MaterialLayer::new("Insulation", 0.300, 0.04, 50.0, 840.0),
    ];
    let mut solver = ImplicitFDSolver::new(layers, 25);
    let interior_bc = SurfaceBC::new_interior(8.0, 20.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, 5.0, 0.0);
    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite()));
    assert!((temps[0] - 20.0).abs() < (temps[temps.len() - 1] - 20.0).abs());
}

/// Test window with extreme cold outdoor temperature
#[test]
fn test_window_extreme_cold() {
    let layers = vec![MaterialLayer::new("Glass", 0.006, 1.0, 2300.0, 840.0)];
    let mut solver = ImplicitFDSolver::new(layers, 20);
    let interior_bc = SurfaceBC::new_interior(8.0, 20.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, -30.0, 0.0);
    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite() && t > -100.0));
}

/// Test window with extreme hot outdoor temperature
#[test]
fn test_window_extreme_hot() {
