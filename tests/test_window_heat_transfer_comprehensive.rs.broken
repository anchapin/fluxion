    solver.step(3600.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite()));
}

/// Test window radiation at extreme temperatures
#[test]
fn test_window_radiation_extreme() {
    let layers = vec![MaterialLayer::new("Glass", 0.006, 1.0, 2300.0, 840.0)];
    let mut solver = ImplicitFDSolver::new(layers, 20);
    let interior_bc = SurfaceBC::new_interior(8.0, -40.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, 50.0, 1500.0);
    solver.step(3600, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite() && t > -200.0 && t < 200.0));
}

