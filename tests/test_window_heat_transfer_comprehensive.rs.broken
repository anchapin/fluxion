/// Test window with very high heat capacity material
#[test]
fn test_window_high_heat_capacity() {
    let layers = vec![MaterialLayer::new("Water wall", 0.100, 1.0, 4180.0, 1000.0)];
    let mut solver = ImplicitFDSolver::new(layers, 20);
    let interior_bc = SurfaceBC::new_interior(8.0, 20.0);
    let exterior_bc = SurfaceBC::new_exterior(25.0, 20.0, 0.0);
    solver.step(7200.0, &interior_bc, &exterior_bc);
    let temps = solver.temperatures();
    assert!(temps.iter().all(|&t| t.is_finite()));
    assert!((temps[0] - 20.0).abs() < 5.0);
}
