! Minimal IDF sample exercising the schedule import (issue #3991,
! "schedules" slice): ScheduleTypeLimits, Schedule:Compact (weekday /
! weekend day types) and Schedule:Constant.
!
! Used by src/io/idf/schedule.rs and src/io/idf/convert.rs tests.

Version, 25.2;

Building,
  ScheduleTestBldg,  !- Name
  0.0,               !- North Axis {deg}
  Suburbs,           !- Terrain
  0.04,              !- Loads Convergence Tolerance Value
  0.4,               !- Temperature Convergence Tolerance Value {deltaC}
  FullExterior,      !- Solar Distribution
  25;                !- Maximum Number of Warmup Days

Zone,
  Z1,                !- Name
  0.0,               !- Direction of Relative North {deg}
  0.0,               !- X Origin {m}
  0.0,               !- Y Origin {m}
  0.0,               !- Z Origin {m}
  1,                 !- Type
  2.7,               !- Ceiling Height {m}
  129.6,             !- Volume {m3}
  48.0,              !- Floor Area {m2}
  ;

Material,
  Mat1,              !- Name
  MediumRough,       !- Roughness
  0.1,               !- Thickness {m}
  1.0,               !- Conductivity {W/m-K}
  2000,              !- Density {kg/m3}
  800;               !- Specific Heat {J/kg-K}

Construction,
  Wall1,             !- Name
  Mat1;              !- Outside Layer

Site:GroundTemperature:BuildingSurface,
  18.0, 18.0, 18.0, 18.0, 18.0, 18.0,
  18.0, 18.0, 18.0, 18.0, 18.0, 18.0;

! ── Schedule type limits ─────────────────────────────────────────────────
ScheduleTypeLimits,
  Fraction,          !- Name
  0.0,               !- Lower Limit
  1.0,               !- Upper Limit
  Continuous;        !- Numeric Type

ScheduleTypeLimits,
  Temperature,       !- Name
  -100.0,            !- Lower Limit
  200.0,             !- Upper Limit
  Continuous;        !- Numeric Type

! ── A compact schedule with two day types ───────────────────────────────
Schedule:Compact,
  Occupancy,         !- Name
  Fraction,          !- Schedule Type Limits Name
  Through: 12/31,    !- Field 1
  For: Weekdays,     !- Field 2
  Until: 08:00, 0.1, !- Field 3
  Until: 18:00, 0.9, !- Field 4
  Until: 24:00, 0.2, !- Field 5
  For: Weekends,     !- Field 6
  Until: 24:00, 0.5; !- Field 7

! ── A constant schedule ──────────────────────────────────────────────────
Schedule:Constant,
  AlwaysOn,          !- Name
  Fraction,          !- Schedule Type Limits Name
  1.0;               !- Constant Value
